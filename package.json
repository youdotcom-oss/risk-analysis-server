{
  "name": "@youdotcom-oss/risk-analsis-server",
  "version": "0.0.1",
  "description": "You.com risk analysis MCP server",
  "license": "MIT",
  "engines": {
    "bun": ">= 1.2.21"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youdotcom-oss/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/youdotcom-oss/mcp/issues"
  },
  "homepage": "https://github.com/youdotcom-oss/mcp#readme",
  "author": "You.com (https://you.com)",
  "keywords": [
    "mcp",
    "web search",
    "model context protocol",
    "ai research"
  ],
  "bin": "bin/stdio.js",
  "type": "module",
  "main": "./src/server.ts",
  "exports": {
    ".": "./src/server.ts",
    "./server": "./src/server.ts",
    "./mcp": "./src/mcp.ts",
    "./pipeline": "./src/pipeline/sweep.ts",
    "./pipeline/deep-dive": "./src/pipeline/deep-dive.ts",
    "./db": "./src/db.ts",
    "./services/you": "./src/services/you.ts",
    "./services/jev": "./src/services/jev.ts",
    "./model": "./src/model.ts"
  },
  "files": [
    "src",
    "bin/stdio.js",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/stdio.ts --outfile ./bin/stdio.js --target=bun && bun scripts/embed-view.ts",
    "start": "bun run ./bin/stdio.js",
    "start:http": "bun src/server.ts",
    "check": "bun run check:skills && bun run check:biome && bun run check:types",
    "check:skills": "bun scripts/validate-skills.ts",
    "check:biome": "biome check",
    "check:types": "tsc --noEmit",
    "check:write": "biome check --write",
    "dev": "bun src/stdio.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "git config core.hooksPath .hooks"
  },
  "mcpName": "io.github.youdotcom-oss/risk-analysis-server",
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.54",
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/bun": "latest",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.107",
    "hono": "^4.13.8",
    "lint-staged": "^17.1.0",
    "typescript": "7.0.2",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0"
  }
}
